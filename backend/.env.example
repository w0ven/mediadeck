# mediadeck backend configuration — copy to .env and fill in.
# NO real values belong in the repository.
#
# Only bootstrap/process-level settings live here. Everything an operator is
# expected to change — Emby connection, streaming nodes, dispatch policy — is
# configured from the panel UI ("系统设置") and stored in the data directory,
# so it can be changed without shell access or a restart.

# Set to 1 to run entirely on mock adapters (no credentials needed)
MEDIADECK_MOCK=1

# Panel auth (single admin for now)
MEDIADECK_ADMIN_USER=admin
MEDIADECK_ADMIN_PASSWORD=change-me

# Where operator settings are persisted (settings.json, mode 600)
MEDIADECK_DATA_DIR=data

# --- bootstrap only -------------------------------------------------------
# Read once on first run to seed the settings store, so pre-existing
# deployments keep working after upgrading. Later edits happen in the UI.
EMBY_URL=http://127.0.0.1:8096
EMBY_API_KEY=

# Optional LOCAL Emby identity authority for restricted entries. Admin personal
# tokens can see global Sessions, which cannot establish their token owner.
# Set both to the same Emby instance used by the runtime integration. Changing
# that URL without rebinding these values fails closed; remote installs retain
# the scoped-session check. Requires existing read access to authentication.db
# (Tokens_2) and users.db (LocalUsersv2); never chmod/chown Emby's credential DBs.
# Connections/queries are read-only and live on each request (no owner cache).
# Example data dir: /srv/emby/config/data — use this host's actual mount path.
MEDIADECK_EMBY_IDENTITY_DATA_DIR=
MEDIADECK_EMBY_IDENTITY_URL=

# Streaming nodes (JSON list; each node exposes a /load probe).
# capacity = max concurrent streams the node can serve.
# Example: [{"name":"node-a","base_url":"https://node-a.example.com","probe_url":"http://10.0.0.2:9800/load","capacity":150}]
STREAM_NODES=[]

# Sanitized JSON snapshots written by host-local collectors (no real paths)
TASKS_SNAPSHOT_PATH=

# --- intake pipeline observability ----------------------------------------
# Where this host's intake stages keep their state. Every key is optional:
# an unset value simply makes that card report "not configured", so the panel
# runs anywhere without inventing a layout. Values below are placeholders.
INTAKE_REFRESH_QUEUE_DIR=
INTAKE_REFRESH_SENT_DIR=
INTAKE_REFRESH_SUPPRESS_FILE=
INTAKE_NOTIFY_PENDING_DIR=
INTAKE_NOTIFY_LOG=
INTAKE_UPLOAD_LANE_ROOT=
INTAKE_STAGING_DIR=
INTAKE_LOCAL_FALLBACK_DIR=
INTAKE_QUARANTINE_DIR=
INTAKE_UPLOAD_STATE_DIR=
INTAKE_CLOUD_CLAIMS_DIR=
INTAKE_CLOUD_DONE_DIR=
INTAKE_CLOUD_PENDING_DIR=
INTAKE_CLOUD_EVENTS_DIR=
INTAKE_CLOUD_BACKLOG_FILE=
INTAKE_CLOUD_QUEUE_FILE=
INTAKE_CLOUD_ACTIVE_FILE=

# Torrent clients summarised on the intake page. JSON list; username/password
# are optional and never leave the process (not logged, not returned by any
# endpoint). Example:
# [{"name":"local","url":"http://127.0.0.1:8080","username":"","password":""}]
INTAKE_DOWNLOADERS=[]
