# Dedicated transparent edge. Render fixed hosts/addresses and private key.
upstream md_wl_origin { server __ORIGIN_IP__:8443; keepalive 16; }
# Do not pool node sockets across members: existing metering owns each socket.
upstream md_wl_node { server __NODE_IP__:443; }
map $http_upgrade $md_wl_upgrade { default upgrade; '' ''; }
map $request_uri $md_wl_node_target {
    default "";
    ~^/_n/__NODE_NAME__(/s/.*)$ $1;
}
map $request_uri $md_wl_dot_segment {
    default 0;
    "~*^[^?]*(?:/|%2f)(?:\.|%2e){1,2}(?:/|%2f|\?|$)" 1;
}
log_format md_whitelist_edge '$time_iso8601 $remote_addr $request_method $uri $status $body_bytes_sent $upstream_addr';
server {
    listen 80 default_server;
    server_name _;
    return 404;
}
server {
    listen 80;
    server_name __ENTRY_HOST__;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://__ENTRY_HOST__$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/__ENTRY_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ENTRY_HOST__/privkey.pem;
    access_log off;
    error_log /dev/null crit;
    return 403;
}
server {
    listen 443 ssl http2;
    server_name __ENTRY_HOST__;
    ssl_certificate /etc/letsencrypt/live/__ENTRY_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ENTRY_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    set $md_wl_entry "__ENTRY_ID__";
    set $md_wl_key "__ENTRY_KEY__";
    if ($host != "__ENTRY_HOST__") { return 403; }
    if ($md_wl_dot_segment) { return 404; }
    access_log /var/log/nginx/mediadeck-whitelist-edge.log md_whitelist_edge;
    error_log /dev/null crit;
    client_max_body_size 0;
    large_client_header_buffers 4 32k;
    merge_slashes off;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_redirect off;
    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Mediadeck-Entry $md_wl_entry;
    proxy_set_header X-Mediadeck-Entry-Key $md_wl_key;
    proxy_hide_header X-Mediadeck-Entry-Key;
    add_header Cache-Control 'private, no-store' always;
    add_header X-Whitelist-Edge __ENTRY_ID__ always;

    location = /_wl_file_admission {
        internal;
        proxy_pass https://md_wl_origin/__md_wl_file;
        proxy_ssl_name __OFFICIAL_HOST__;
        proxy_set_header Host __OFFICIAL_HOST__;
        proxy_pass_request_headers off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $md_wl_file_uri;
        proxy_set_header X-Original-Method $md_wl_file_method;
        proxy_set_header X-Mediadeck-Entry $md_wl_entry;
        proxy_set_header X-Mediadeck-Entry-Key $md_wl_key;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location ^~ /_n/__NODE_NAME__/s/ {
        if ($request_method !~ "^(GET|HEAD)$") { return 405; }
        if ($md_wl_node_target = "") { return 404; }
        set $md_wl_file_uri $request_uri;
        set $md_wl_file_method $request_method;
        auth_request /_wl_file_admission;
        proxy_pass https://md_wl_node$md_wl_node_target;
        proxy_set_header Host __NODE_HOST__;
        proxy_ssl_name __NODE_HOST__;
        proxy_set_header Authorization "";
        proxy_set_header X-Emby-Token "";
        proxy_set_header X-MediaBrowser-Token "";
        proxy_set_header X-Emby-Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Mediadeck-Entry "";
        proxy_set_header X-Mediadeck-Entry-Key "";
        proxy_set_header X-Original-URI "";
        proxy_set_header X-Original-Method "";
        proxy_set_header Connection close;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
    }
    location = /_n { return 404; }
    location ^~ /_n/ { return 404; }
    location ^~ /s/ { return 404; }
    location ^~ /__md { return 404; }
    location / {
        proxy_pass https://md_wl_origin;
        proxy_set_header Host __OFFICIAL_HOST__;
        proxy_ssl_name __OFFICIAL_HOST__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $md_wl_upgrade;
        proxy_set_header X-Mediadeck-Entry $md_wl_entry;
        proxy_set_header X-Mediadeck-Entry-Key $md_wl_key;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
